        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          (
            getAfter(/databases/$(database)/documents/professional_profiles/$(incoming().profileId)).data.ownerId == request.auth.uid &&
            incoming().publicationStatus == getAfter(/databases/$(database)/documents/professional_profiles/$(incoming().profileId)).data.publicationStatus
          ) ||
          isAdmin()
        );

      allow update: if isVerifiedUser() &&
        isValidId(serviceId) &&
        isValidProfessionalService(incoming()) &&
        incoming().id == existing().id &&
        incoming().profileId == existing().profileId &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (
            existing().ownerId == request.auth.uid &&
            incoming().publicationStatus == getAfter(/databases/$(database)/documents/professional_profiles/$(incoming().profileId)).data.publicationStatus &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'serviceName', 'description', 'conditions', 'price', 'hasFixedPrice',
              'deliveryMethod', 'availabilityStatus', 'publicationStatus', 'updatedAt'
            ])
          ) ||
          isAdmin()
        );

      allow delete: if isVerifiedUser() && isValidId(serviceId) && (
        existing().ownerId == request.auth.uid || isAdmin()
      );
    }

    // --- /professional_media/{mediaId} ---
    match /professional_media/{mediaId} {
      allow get: if isValidId(mediaId) && (
        existing().publicationStatus == 'published' ||
        (isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin()))
      );

      allow list: if existing().publicationStatus == 'published' ||
        (isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin()));

      allow create: if isVerifiedUser() &&
        isValidId(mediaId) &&
        isValidProfessionalMedia(incoming()) &&
        incoming().id == mediaId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          (
            getAfter(/databases/$(database)/documents/professional_profiles/$(incoming().profileId)).data.ownerId == request.auth.uid &&
            incoming().publicationStatus == getAfter(/databases/$(database)/documents/professional_profiles/$(incoming().profileId)).data.publicationStatus
          ) ||
          isAdmin()
        );

      allow update: if isVerifiedUser() &&
        isValidId(mediaId) &&
        isValidProfessionalMedia(incoming()) &&
        incoming().id == existing().id &&
        incoming().profileId == existing().profileId &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (
            existing().ownerId == request.auth.uid &&
            incoming().publicationStatus == getAfter(/databases/$(database)/documents/professional_profiles/$(incoming().profileId)).data.publicationStatus &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'fileType', 'caption', 'storageRef', 'uploadStatus', 'publicationStatus', 'updatedAt'
            ])
          ) ||
          isAdmin()
        );

      allow delete: if isVerifiedUser() && isValidId(mediaId) && (
        existing().ownerId == request.auth.uid || isAdmin()
      );
    }

    // --- /availability_schedules/{scheduleId} ---
    match /availability_schedules/{scheduleId} {
      allow get: if isValidId(scheduleId) && (
        existing().publicationStatus == 'published' ||
        (isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin()))
      );

      allow list: if existing().publicationStatus == 'published' ||
        (isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin()));

      allow create: if isVerifiedUser() &&
        isValidId(scheduleId) &&
        isValidAvailabilitySchedule(incoming()) &&
        incoming().id == scheduleId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          (
            getAfter(/databases/$(database)/documents/professional_profiles/$(incoming().profileId)).data.ownerId == request.auth.uid &&
            incoming().publicationStatus == getAfter(/databases/$(database)/documents/professional_profiles/$(incoming().profileId)).data.publicationStatus
          ) ||
          isAdmin()
        );

      allow update: if isVerifiedUser() &&
        isValidId(scheduleId) &&
        isValidAvailabilitySchedule(incoming()) &&
        incoming().id == existing().id &&
        incoming().profileId == existing().profileId &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (
            existing().ownerId == request.auth.uid &&
            incoming().publicationStatus == getAfter(/databases/$(database)/documents/professional_profiles/$(incoming().profileId)).data.publicationStatus &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'dayOfWeek', 'dayLabel', 'isOpen', 'openingTime', 'closingTime', 'notes', 'publicationStatus', 'updatedAt'
            ])
          ) ||
          isAdmin()
        );

      allow delete: if isVerifiedUser() && isValidId(scheduleId) && (
        existing().ownerId == request.auth.uid || isAdmin()
      );
    }

    // --- /audit_logs/{logId} (Immutable Audit Trail) ---
    match /audit_logs/{logId} {
      allow get: if isSignedIn() && isValidId(logId) && (existing().actorId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().actorId == request.auth.uid || isAdmin());

      allow create: if isVerifiedUser() &&
        isValidId(logId) &&
        isValidAuditLog(incoming()) &&
        incoming().id == logId &&
        incoming().createdAt == request.time;

      allow update, delete: if false;
    }

    // =========================================================================
    // 4. MODULE 2: COMPANIES & INSTITUTIONS (EMPRESAS E INSTITUIÇÕES)
    // =========================================================================

    // --- /companies/{companyId} ---
    match /companies/{companyId} {
      allow get: if isValidId(companyId) && (
        existing().publicationStatus == 'published' ||
        (isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin()))
      );

      allow list: if existing().publicationStatus == 'published' ||
        (isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin()));

      allow create: if isVerifiedUser() &&
        isValidId(companyId) &&
        isValidCompany(incoming()) &&
        incoming().id == companyId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          incoming().publicationStatus == 'draft' ||
          isPublishableCompany(incoming())
        ) &&
        (
          (
            incoming().ownerId == request.auth.uid &&
            (
              incoming().phoneVerified == false ||
              incoming().phoneVerified == (request.auth.token.phone_number != null)
            ) &&
            incoming().companyVerified == false &&
            incoming().publicationStatus in ['draft', 'pending_review', 'published']
          ) ||
          isAdmin()
        );

      allow update: if isVerifiedUser() &&
        isValidId(companyId) &&
        isValidCompany(incoming()) &&
        incoming().id == existing().id &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          incoming().publicationStatus == 'draft' ||
          isPublishableCompany(incoming())
        ) &&
        (
          // Action 1: Owner updates their company details (cannot forge companyVerified)
          (
            existing().ownerId == request.auth.uid &&
            existing().publicationStatus != 'suspended' &&
            incoming().companyVerified == existing().companyVerified &&
            (
              incoming().phoneVerified == existing().phoneVerified ||
              incoming().phoneVerified == (request.auth.token.phone_number != null)
            ) &&
            incoming().publicationStatus in ['draft', 'pending_review', 'published'] &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'entityType', 'officialName', 'displayName', 'nuit',
              'primaryCategoryId', 'primaryCategoryName', 'subcategory', 'description',
              'logoUrl', 'photoUrl', 'videoUrl', 'videoViews', 'viewsCount',
              'responsibleName', 'responsibleRole', 'phone', 'whatsapp', 'email',
              'phoneVerified', 'authorizedPublication',
              'province', 'district', 'locality', 'neighborhood', 'streetOrReference', 'nearestStop',
              'hasGps', 'latitude', 'longitude',
              'operationalState', 'workingDaysSummary', 'openingTime', 'closingTime',
              'publicationStatus', 'rejectionReason', 'updatedAt'
            ])
          ) ||
          // Action 2: Owner toggles operational state only
          (
            existing().ownerId == request.auth.uid &&
            existing().publicationStatus != 'suspended' &&
            incoming().publicationStatus == existing().publicationStatus &&
            incoming().companyVerified == existing().companyVerified &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'operationalState', 'updatedAt'
            ])
          ) ||
          // Action 3: Anyone increments videoViews and viewsCount when accessing video
          (
            existing().publicationStatus == 'published' &&
            incoming().id == existing().id &&
            incoming().ownerId == existing().ownerId &&
            incoming().publicationStatus == existing().publicationStatus &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'videoViews', 'viewsCount', 'updatedAt'
            ])
          ) ||
          // Action 4: Administrator full moderation & company verification
          isAdmin()
        );

      allow delete: if isAdmin() && isValidId(companyId);
    }

    // --- /company_categories/{categoryId} ---
    match /company_categories/{categoryId} {
      allow get: if isValidId(categoryId) && (
        existing().reviewStatus in ['approved', 'pending', 'merged'] ||
        (isSignedIn() && (existing().creatorId == request.auth.uid || isAdmin()))
      );

      allow list: if existing().reviewStatus in ['approved', 'pending', 'merged'] ||
        (isSignedIn() && (existing().creatorId == request.auth.uid || isAdmin()));

      allow create: if isVerifiedUser() &&
        isValidId(categoryId) &&
        isValidCompanyCategory(incoming()) &&
        incoming().id == categoryId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          (
            incoming().creatorId == request.auth.uid &&
            incoming().reviewStatus == 'pending'
          ) ||
          isAdmin()
        );

      allow update: if isVerifiedUser() &&
        isValidId(categoryId) &&
        isValidCompanyCategory(incoming()) &&
        incoming().id == existing().id &&
        isAdmin();

      allow delete: if isAdmin() && isValidId(categoryId);
    }

    // --- /company_services/{serviceId} ---
    match /company_services/{serviceId} {
      allow get: if isValidId(serviceId) && (
        existing().publicationStatus == 'published' ||
        (isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin()))
      );

      allow list: if existing().publicationStatus == 'published' ||
        (isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin()));

      allow create: if isVerifiedUser() &&
        isValidId(serviceId) &&
        isValidCompanyService(incoming()) &&
