  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Private user account records."
    },
    "/user_consultations/{consultationId}": {
      "schema": "UserConsultation",
      "description": "Idempotent direct consultation receipts (userId_targetProfileId)."
    },
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Administrator registry records."
    },
    "/professional_profiles/{profileId}": {
      "schema": "ProfessionalProfile",
      "description": "Professional, service provider, and street vendor profiles."
    },
    "/professional_categories/{categoryId}": {
      "schema": "ProfessionalCategory",
      "description": "Dynamic professional categories and specialties."
    },
    "/professional_specialties/{specialtyAssocId}": {
      "schema": "ProfessionalSpecialty",
      "description": "Associations between professional profiles and specialty categories."
    },
    "/professional_services/{serviceId}": {
      "schema": "ProfessionalService",
      "description": "Individual services offered by professionals."
    },
    "/professional_media/{mediaId}": {
      "schema": "ProfessionalMedia",
      "description": "Profile photos and work gallery media."
    },
    "/availability_schedules/{scheduleId}": {
      "schema": "AvailabilitySchedule",
      "description": "Weekly working hours schedules for professionals."
    },
    "/audit_logs/{logId}": {
      "schema": "AuditLog",
      "description": "Immutable audit trail of profile and category operations."
    }
  }
}
