{
  "entities": {
    "User": {
      "title": "User",
      "description": "Private user (Utente / Profissional / Admin) account identity, location, terms acceptance, and credit balance.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique user UID matching Firebase Auth UID."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "User full name or display name."
        },
        "email": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120,
          "description": "User email address."
        },
        "phone": {
          "type": "string",
          "minLength": 0,
          "maxLength": 40,
          "description": "Primary phone number."
        },
        "whatsapp": {
          "type": "string",
          "minLength": 0,
          "maxLength": 40,
          "description": "WhatsApp contact number (+258)."
        },
        "province": {
          "type": "string",
          "minLength": 0,
          "maxLength": 80,
          "description": "Utente province in Mozambique."
        },
        "district": {
          "type": "string",
          "minLength": 0,
          "maxLength": 80,
          "description": "Utente district in Mozambique."
        },
        "neighborhood": {
          "type": "string",
          "minLength": 0,
          "maxLength": 100,
          "description": "Utente neighborhood (Bairro)."
        },
        "termsAccepted": {
          "type": "boolean",
          "description": "Whether the user accepted the MozFácil terms and 1 credit (1 MT) per consultation rule."
        },
        "creditsBalance": {
          "type": "number",
          "description": "Current balance of consultation credits (1 credit = 1 MT; initial package = 100 credits)."
        },
        "consultationsCount": {
          "type": "number",
          "description": "Total number of direct consultations performed by this user."
        },
        "role": {
          "type": "string",
          "enum": ["visitor", "professional", "admin"],
          "description": "Role assigned to the user."
        },
        "phoneVerified": {
          "type": "boolean",
          "description": "Whether the phone number has been verified via real OTP or Admin."
        },
        "emailVerified": {
          "type": "boolean",
          "description": "Whether the email address is verified by Firebase Auth."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update."
        }
      },
      "required": [
        "id",
        "displayName",
        "email",
        "phone",
        "whatsapp",
        "province",
        "district",
        "neighborhood",
        "termsAccepted",
        "creditsBalance",
        "consultationsCount",
        "role",
        "phoneVerified",
        "emailVerified",
        "createdAt",
        "updatedAt"
      ]
    },
    "Admin": {
      "title": "Admin",
      "description": "Administrator privilege record.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
